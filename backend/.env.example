# Copia a .env y sustituye TODOS los valores *** por cadenas aleatorias seguras.
PORT=3000
PUBLIC_HOST=127.0.0.1
# Para despliegue compartido, PUBLIC_HOST=0.0.0.0 solo tras configurar TLS en proxy externo.
JWT_SECRET=***64-caracteres-o-mas***
INVENTORY_SERVICE_KEY=***32-caracteres-o-mas***
ORDERS_SERVICE_KEY=***32-caracteres-o-mas***
CLIENTS_SERVICE_KEY=***32-caracteres-o-mas***
PAYMENTS_SERVICE_KEY=***32-caracteres-o-mas***
GRAPHQL_SERVICE_KEY=***32-caracteres-o-mas***
PAYMENT_WEBHOOK_SECRET=***32-caracteres-o-mas***
# Opcional: DB_DIR=./data
# Crear admin una sola vez (no subir datos a git):
# ADMIN_EMAIL=admin@example.invalid
# ADMIN_PASSWORD=***clave-segura***
# ADMIN_NAME=Administración
# ADMIN_ROLE=admin

# Activar solo para demostraciones locales sin cobros reales:
PAYMENTS_DEMO=1
