    }
    class GraphQLService {
      <<service>>
      +POST resumenPedido() S19
      +POST misPedidos() S19
    }
    Cliente "1" --> "0..*" Pedido : realiza
    Pedido "1" *-- "1..*" DetallePedido : contiene
    Producto "1" --> "0..*" DetallePedido : referencia
    Pedido "1" --> "0..1" Pago : tiene
    CatalogService ..> Producto : usa DTO
    OrdersService ..> Pedido : administra
    ClientsService ..> Cliente : administra
    PaymentsService ..> Pago : administra
    GraphQLService ..> Pedido : consultaDTO
    GraphQLService ..> Producto : agregaDTO
